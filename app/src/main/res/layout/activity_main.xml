<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F6F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI 검색 차단"
            android:textColor="#17202A"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Google AI 모드와 주요 생성형 AI 사이트를 차단하고, 일반 Google 검색은 AI 개요가 없는 웹 검색으로 자동 전환합니다."
            android:textColor="#566573"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#FFFFFF"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="차단 상태"
                android:textColor="#566573"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="확인 중..."
                android:textColor="#17202A"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/accessibilityStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="접근성 권한 확인 중..."
                android:textColor="#566573"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/managedInfoText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#EAF3FF"
            android:padding="16dp"
            android:text="중앙관리 연결됨 · 설치 후 접근성 서비스만 한 번 켜면 됩니다. 차단 설정과 AI 사이트 목록은 교사용 중앙관리에서 자동 동기화됩니다."
            android:textColor="#1F4E79"
            android:textSize="14sp" />

        <Button
            android:id="@+id/toggleButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:minHeight="56dp"
            android:text="중앙관리 모드"
            android:textSize="17sp" />

        <Button
            android:id="@+id/accessibilityButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="52dp"
            android:text="접근성 권한 설정"
            android:textSize="16sp" />

        <Button
            android:id="@+id/changePinButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="52dp"
            android:text="PIN은 중앙관리에서 변경"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#FFF7E6"
            android:padding="16dp"
            android:text="앱 삭제 방지는 학교 MDM에서 kr.school.aimodeblocker 패키지를 삭제 금지로 지정하세요."
            android:textColor="#7D6608"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
